{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GithubOidcPreflightEnvironmentOnly",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::ACCOUNT_ID_PLACEHOLDER:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:marciozampiron/backstage-cba-prep:environment:ENVIRONMENT_PLACEHOLDER"
        }
      }
    }
  ]
}
