{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadReleaseBootstrapVersionParameter",
      "Effect": "Allow",
      "Action": "ssm:GetParameters",
      "Resource": "arn:aws:ssm:us-east-1:ACCOUNT_ID_PLACEHOLDER:parameter/cdk-bootstrap/QUALIFIER_PLACEHOLDER/version"
    },
    {
      "Sid": "ReadReleaseAssetsFromBootstrapBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::cdk-QUALIFIER_PLACEHOLDER-assets-ACCOUNT_ID_PLACEHOLDER-us-east-1",
        "arn:aws:s3:::cdk-QUALIFIER_PLACEHOLDER-assets-ACCOUNT_ID_PLACEHOLDER-us-east-1/*"
      ]
    },
    {
      "Sid": "LambdaLifecycleOnOwnFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:AddPermission",
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:DeleteFunctionConcurrency",
        "lambda:GetFunction",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:GetRuntimeManagementConfig",
        "lambda:ListTags",
        "lambda:ListVersionsByFunction",
        "lambda:PublishVersion",
        "lambda:PutFunctionConcurrency",
        "lambda:RemovePermission",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": "arn:aws:lambda:us-east-1:ACCOUNT_ID_PLACEHOLDER:function:cba-study-coach-ENVIRONMENT_PLACEHOLDER-*"
    },
    {
      "Sid": "ApiGatewayV2CreateOnlyProjectTaggedApis",
      "Effect": "Allow",
      "Action": "apigateway:POST",
      "Resource": "arn:aws:apigateway:us-east-1::/apis",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "CBAStudyCoach",
          "aws:RequestTag/Environment": "ENVIRONMENT_PLACEHOLDER"
        }
      }
    },
    {
      "Sid": "ApiGatewayV2RootLifecycleOnlyOnProjectTaggedApis",
      "Effect": "Allow",
      "Action": [
        "apigateway:DELETE",
        "apigateway:GET",
        "apigateway:PATCH",
        "apigateway:PUT"
      ],
      "Resource": "arn:aws:apigateway:us-east-1::/apis/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "CBAStudyCoach",
          "aws:ResourceTag/Environment": "ENVIRONMENT_PLACEHOLDER"
        }
      }
    },
    {
      "Sid": "ApiGatewayV2ChildLifecycleOnlyOnProjectTaggedApis",
      "Effect": "Allow",
      "Action": [
        "apigateway:DELETE",
        "apigateway:GET",
        "apigateway:PATCH",
        "apigateway:POST",
        "apigateway:PUT"
      ],
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis/*/routes",
        "arn:aws:apigateway:us-east-1::/apis/*/routes/*",
        "arn:aws:apigateway:us-east-1::/apis/*/integrations",
        "arn:aws:apigateway:us-east-1::/apis/*/integrations/*",
        "arn:aws:apigateway:us-east-1::/apis/*/authorizers",
        "arn:aws:apigateway:us-east-1::/apis/*/authorizers/*",
        "arn:aws:apigateway:us-east-1::/apis/*/stages",
        "arn:aws:apigateway:us-east-1::/apis/*/stages/*",
        "arn:aws:apigateway:us-east-1::/apis/*/deployments",
        "arn:aws:apigateway:us-east-1::/apis/*/deployments/*",
        "arn:aws:apigateway:us-east-1::/apis/*/cors"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "CBAStudyCoach",
          "aws:ResourceTag/Environment": "ENVIRONMENT_PLACEHOLDER"
        }
      }
    },
    {
      "Sid": "ApiGatewayV2TagReadAndWriteOnlyOnOwnedResources",
      "Effect": "Allow",
      "Action": [
        "apigateway:DELETE",
        "apigateway:GET",
        "apigateway:POST"
      ],
      "Resource": "arn:aws:apigateway:us-east-1::/tags/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "CBAStudyCoach",
          "aws:ResourceTag/Environment": "ENVIRONMENT_PLACEHOLDER"
        }
      }
    },
    {
      "Sid": "DenyGovernanceTagRemoval",
      "Effect": "Deny",
      "Action": "apigateway:DELETE",
      "Resource": "arn:aws:apigateway:us-east-1::/tags/*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "Project",
            "Environment"
          ]
        }
      }
    },
    {
      "Sid": "DenyProjectTagReplacement",
      "Effect": "Deny",
      "Action": "apigateway:POST",
      "Resource": "arn:aws:apigateway:us-east-1::/tags/*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "Project"
          ]
        },
        "StringNotEquals": {
          "aws:RequestTag/Project": "CBAStudyCoach"
        }
      }
    },
    {
      "Sid": "DenyEnvironmentTagReplacement",
      "Effect": "Deny",
      "Action": "apigateway:POST",
      "Resource": "arn:aws:apigateway:us-east-1::/tags/*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "Environment"
          ]
        },
        "StringNotEquals": {
          "aws:RequestTag/Environment": "ENVIRONMENT_PLACEHOLDER"
        }
      }
    },
    {
      "Sid": "DynamoLifecycleOnOwnTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:ListTagsOfResource",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:UpdateTable",
        "dynamodb:UpdateTimeToLive"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:ACCOUNT_ID_PLACEHOLDER:table/cba-study-coach-ENVIRONMENT_PLACEHOLDER-*"
    },
    {
      "Sid": "CognitoCreateOnlyProjectTaggedPools",
      "Effect": "Allow",
      "Action": "cognito-idp:CreateUserPool",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "CBAStudyCoach",
          "aws:RequestTag/Environment": "ENVIRONMENT_PLACEHOLDER"
        }
      }
    },
    {
      "Sid": "CognitoLifecycleOnlyOnProjectTaggedPools",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:CreateGroup",
        "cognito-idp:CreateUserPoolClient",
        "cognito-idp:CreateUserPoolDomain",
        "cognito-idp:DeleteGroup",
        "cognito-idp:DeleteUserPool",
        "cognito-idp:DeleteUserPoolClient",
        "cognito-idp:DeleteUserPoolDomain",
        "cognito-idp:DescribeUserPool",
        "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:DescribeUserPoolDomain",
        "cognito-idp:GetGroup",
        "cognito-idp:GetUICustomization",
        "cognito-idp:SetUICustomization",
        "cognito-idp:SetUserPoolMfaConfig",
        "cognito-idp:TagResource",
        "cognito-idp:UntagResource",
        "cognito-idp:UpdateGroup",
        "cognito-idp:UpdateUserPool",
        "cognito-idp:UpdateUserPoolClient"
      ],
      "Resource": "arn:aws:cognito-idp:us-east-1:ACCOUNT_ID_PLACEHOLDER:userpool/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "CBAStudyCoach",
          "aws:ResourceTag/Environment": "ENVIRONMENT_PLACEHOLDER"
        }
      }
    },
    {
      "Sid": "CloudWatchAlarmsOnOwnNames",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DeleteAlarms",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:ListTagsForResource",
        "cloudwatch:PutCompositeAlarm",
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource"
      ],
      "Resource": "arn:aws:cloudwatch:us-east-1:ACCOUNT_ID_PLACEHOLDER:alarm:cba-study-coach-ENVIRONMENT_PLACEHOLDER-*"
    },
    {
      "Sid": "CloudWatchDashboardsOnOwnNames",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DeleteDashboards",
        "cloudwatch:GetDashboard",
        "cloudwatch:PutDashboard"
      ],
      "Resource": "arn:aws:cloudwatch::ACCOUNT_ID_PLACEHOLDER:dashboard/cba-study-coach-ENVIRONMENT_PLACEHOLDER-*"
    },
    {
      "Sid": "LogsLifecycleOnOwnGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:ListTagsForResource",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": "arn:aws:logs:us-east-1:ACCOUNT_ID_PLACEHOLDER:log-group:*cba-study-coach-ENVIRONMENT_PLACEHOLDER-*"
    },
    {
      "Sid": "LogsQueryDefinitionsCarryNoScopingArn",
      "Effect": "Allow",
      "Action": [
        "logs:DeleteQueryDefinition",
        "logs:DescribeLogGroups",
        "logs:DescribeQueryDefinitions",
        "logs:PutQueryDefinition"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SnsLifecycleOnOwnTopics",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:GetTopicAttributes",
        "sns:ListTagsForResource",
        "sns:SetTopicAttributes",
        "sns:TagResource",
        "sns:UntagResource"
      ],
      "Resource": "arn:aws:sns:us-east-1:ACCOUNT_ID_PLACEHOLDER:cba-study-coach-ENVIRONMENT_PLACEHOLDER-*"
    },
    {
      "Sid": "KmsCreateOnlyProjectTaggedKeys",
      "Effect": "Allow",
      "Action": "kms:CreateKey",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "CBAStudyCoach",
          "aws:RequestTag/Environment": "ENVIRONMENT_PLACEHOLDER"
        }
      }
    },
    {
      "Sid": "KmsKeyLifecycleOnlyOnProjectTaggedKeys",
      "Effect": "Allow",
      "Action": [
        "kms:CancelKeyDeletion",
        "kms:DescribeKey",
        "kms:EnableKeyRotation",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:ListResourceTags",
        "kms:PutKeyPolicy",
        "kms:ScheduleKeyDeletion",
        "kms:TagResource",
        "kms:UntagResource",
        "kms:UpdateKeyDescription"
      ],
      "Resource": "arn:aws:kms:us-east-1:ACCOUNT_ID_PLACEHOLDER:key/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "CBAStudyCoach",
          "aws:ResourceTag/Environment": "ENVIRONMENT_PLACEHOLDER"
        }
      }
    },
    {
      "Sid": "KmsAliasesOnOwnNames",
      "Effect": "Allow",
      "Action": [
        "kms:CreateAlias",
        "kms:DeleteAlias",
        "kms:UpdateAlias"
      ],
      "Resource": [
        "arn:aws:kms:us-east-1:ACCOUNT_ID_PLACEHOLDER:alias/cba-study-coach-ENVIRONMENT_PLACEHOLDER-*",
        "arn:aws:kms:us-east-1:ACCOUNT_ID_PLACEHOLDER:key/*"
      ]
    },
    {
      "Sid": "CreateRuntimeRolesOnlyWithPinnedBoundary",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID_PLACEHOLDER:role/cba-study-coach-ENVIRONMENT_PLACEHOLDER-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::ACCOUNT_ID_PLACEHOLDER:policy/cba-study-coach-boundary-runtime-ENVIRONMENT_PLACEHOLDER"
        }
      }
    },
    {
      "Sid": "RuntimeRoleLifecycleOnOwnNames",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:aws:iam::ACCOUNT_ID_PLACEHOLDER:role/cba-study-coach-ENVIRONMENT_PLACEHOLDER-*"
    },
    {
      "Sid": "AttachOnlyTheLambdaBasicExecutionManagedPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::ACCOUNT_ID_PLACEHOLDER:role/cba-study-coach-ENVIRONMENT_PLACEHOLDER-*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        }
      }
    },
    {
      "Sid": "PassRuntimeRolesToLambdaOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID_PLACEHOLDER:role/cba-study-coach-ENVIRONMENT_PLACEHOLDER-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyGovernanceTagRemovalOnTagScopedFamilies",
      "Effect": "Deny",
      "Action": [
        "cognito-idp:UntagResource",
        "kms:UntagResource"
      ],
      "Resource": [
        "arn:aws:cognito-idp:us-east-1:ACCOUNT_ID_PLACEHOLDER:userpool/*",
        "arn:aws:kms:us-east-1:ACCOUNT_ID_PLACEHOLDER:key/*"
      ],
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "Project",
            "Environment"
          ]
        }
      }
    },
    {
      "Sid": "DenyProjectTagReplacementOnTagScopedFamilies",
      "Effect": "Deny",
      "Action": [
        "cognito-idp:TagResource",
        "kms:TagResource"
      ],
      "Resource": [
        "arn:aws:cognito-idp:us-east-1:ACCOUNT_ID_PLACEHOLDER:userpool/*",
        "arn:aws:kms:us-east-1:ACCOUNT_ID_PLACEHOLDER:key/*"
      ],
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "Project"
          ]
        },
        "StringNotEquals": {
          "aws:RequestTag/Project": "CBAStudyCoach"
        }
      }
    },
    {
      "Sid": "DenyEnvironmentTagReplacementOnTagScopedFamilies",
      "Effect": "Deny",
      "Action": [
        "cognito-idp:TagResource",
        "kms:TagResource"
      ],
      "Resource": [
        "arn:aws:cognito-idp:us-east-1:ACCOUNT_ID_PLACEHOLDER:userpool/*",
        "arn:aws:kms:us-east-1:ACCOUNT_ID_PLACEHOLDER:key/*"
      ],
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": [
            "Environment"
          ]
        },
        "StringNotEquals": {
          "aws:RequestTag/Environment": "ENVIRONMENT_PLACEHOLDER"
        }
      }
    },
    {
      "Sid": "DenyTouchingGithubAndFoundationRoles",
      "Effect": "Deny",
      "Action": "iam:*",
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID_PLACEHOLDER:role/cba-study-coach-gha-*",
        "arn:aws:iam::ACCOUNT_ID_PLACEHOLDER:role/cdk-hnb659fds-*"
      ]
    },
    {
      "Sid": "DenyBoundaryDetachOrSwapOnRuntimeRoles",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRolePermissionsBoundary",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::ACCOUNT_ID_PLACEHOLDER:role/cba-study-coach-ENVIRONMENT_PLACEHOLDER-*"
    },
    {
      "Sid": "DenyRuntimeBoundaryPolicyMutation",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": "arn:aws:iam::ACCOUNT_ID_PLACEHOLDER:policy/cba-study-coach-boundary-runtime-ENVIRONMENT_PLACEHOLDER"
    }
  ]
}
